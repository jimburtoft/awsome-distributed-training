From 009fe14fe77b70e05e63bf462e59a099d631bca6 Mon Sep 17 00:00:00 2001
From: jimburtoft <jimburtoft@users.noreply.github.com>
Date: Sun, 15 Nov 2026 23:22:21 +0000
Subject: [PATCH 2/2] Optional explicit causal mask for SDPA
 (SDPA_EXPLICIT_MASK=1)

Some backends cannot compile the fused is_causal=True attention (AWS Trainium1 with
PyTorch Native). The opt-in path builds the same causal mask explicitly; the default
is unchanged.
---
 picotron/model.py | 10 +++++++++-
 1 file changed, 9 insertions(+), 1 deletion(-)

diff --git a/picotron/model.py b/picotron/model.py
index fa1fbfc..2622262 100644
--- a/picotron/model.py
+++ b/picotron/model.py
@@ -158,7 +158,15 @@ class Attention(nn.Module):
             out = flash_attention(q, k, v, causal = causal) # [batch_size, seq_length, num_heads, head_dim] 
         else:
             # Pytorch scaled dot product attention
-            out = F.scaled_dot_product_attention(q, k, v, is_causal=causal) # [batch_size, num_heads, seq_length, head_dim]
+            if causal and os.getenv('SDPA_EXPLICIT_MASK', '0') == '1':
+                # Same causal attention with an explicit boolean mask instead of is_causal=True. Opt-in for backends
+                # that cannot compile the fused causal kernel (AWS Trainium1 / PyTorch Native, testing only).
+                # Additive mask with the dtype's minimum, not -inf or a boolean mask: on Trainium1 those give NaN gradients.
+                keep = torch.ones(q.size(-2), k.size(-2), dtype=torch.bool).tril()
+                mask = torch.zeros(keep.shape, dtype=q.dtype).masked_fill(~keep, torch.finfo(q.dtype).min).to(q.device)
+                out = F.scaled_dot_product_attention(q, k, v, attn_mask=mask)
+            else:
+                out = F.scaled_dot_product_attention(q, k, v, is_causal=causal) # [batch_size, num_heads, seq_length, head_dim]
             out = out.transpose(1, 2) # [batch_size, seq_length, num_heads, head_dim]
         
         out = out.reshape(batch_size, seq_length, self.num_local_heads * self.head_dim) # [batch_size, seq_length, hidden_dim]
